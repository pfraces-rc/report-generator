{
  "editor.rulers": [80],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "javascript.preferences.importModuleSpecifierEnding": "js",
  "eslint.useFlatConfig": true,
  "files.associations": {
    ".env": "env"
  },
  "[env]": {
    "editor.defaultFormatter": "IronGeek.vscode-env"
  }
}
